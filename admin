-- =====================
-- GRAB REMOTE
-- =====================
local AdminCommandEvent
pcall(function()
    AdminCommandEvent = RS:WaitForChild("ADMIN")
        :WaitForChild("RemoteEvents")
        :WaitForChild("AdminCommandEvent")
end)

local function FireCommand(cmd)
    cmd = cmd:match("^%s*(.-)%s*$")
    if not cmd or #cmd == 0 then return end
    if AdminCommandEvent then
        pcall(function() AdminCommandEvent:FireServer(cmd) end)
    end
    print("[Falz] Fired: " .. cmd)
end

