-- BUILD TABS + COMMANDS
-- =====================
local activeTab = nil
local tabBtns = {}
local cmdRows = {}

local function showCategory(catName)
    activeTab = catName
    for name, btn in pairs(tabBtns) do
        local sel = name == catName
        btn.BackgroundColor3 = sel
            and Color3.fromRGB(60, 60, 90)
            or  Color3.fromRGB(35, 35, 50)
        btn.TextColor3 = sel
            and Color3.fromRGB(255, 255, 255)
            or  Color3.fromRGB(160, 160, 190)
    end
    for _, row in ipairs(cmdScroll:GetChildren()) do
        if row:IsA("Frame") then row:Destroy() end
    end
    for _, cat in ipairs(CATEGORIES) do
        if cat.name ~= catName then continue end
        for i, cmd in ipairs(cat.cmds) do
            local row = Instance.new("Frame", cmdScroll)
            row.Name = "Row_" .. i
            row.Size = UDim2.new(1, 0, 0, 38)
            row.BackgroundColor3 = i % 2 == 0
                and Color3.fromRGB(38, 38, 50)
                or  Color3.fromRGB(32, 32, 44)
            row.BorderSizePixel = 0
            row.LayoutOrder = i
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

            -- emoji
            local emojiLbl = Instance.new("TextLabel", row)
            emojiLbl.Size = UDim2.new(0, 32, 1, 0)
            emojiLbl.Position = UDim2.new(0, 4, 0, 0)
            emojiLbl.BackgroundTransparency = 1
            emojiLbl.Text = cmd.emoji
            emojiLbl.TextSize = 16
            emojiLbl.Font = Enum.Font.GothamMedium

            -- command name
            local nameLbl = Instance.new("TextLabel", row)
            nameLbl.Size = UDim2.new(0, 160, 1, 0)
            nameLbl.Position = UDim2.new(0, 38, 0, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = cmd.name
            nameLbl.TextColor3 = Color3.fromRGB(170, 255, 0)
            nameLbl.TextSize = 13
            nameLbl.Font = Enum.Font.Code
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left

            -- arg input
            local argBg = Instance.new("Frame", row)
            argBg.Size = UDim2.new(0, 160, 0, 26)
            argBg.Position = UDim2.new(0, 200, 0.5, -13)
            argBg.BackgroundColor3 = Color3.fromRGB(22, 22, 32)
            argBg.BorderSizePixel = 0
            Instance.new("UICorner", argBg).CornerRadius = UDim.new(0, 5)

            local argBox = Instance.new("TextBox", argBg)
            argBox.Size = UDim2.new(1, -8, 1, 0)
            argBox.Position = UDim2.new(0, 6, 0, 0)
            argBox.BackgroundTransparency = 1
            argBox.TextColor3 = Color3.fromRGB(210, 210, 210)
            argBox.PlaceholderText = cmd.arg ~= "" and cmd.arg or "—"
            argBox.PlaceholderColor3 = Color3.fromRGB(80, 80, 110)
            argBox.Text = ""
            argBox.TextSize = 11
            argBox.Font = Enum.Font.Code
            argBox.ClearTextOnFocus = false
            argBox.TextXAlignment = Enum.TextXAlignment.Left

            -- run button
            local runBtn = Instance.new("TextButton", row)
            runBtn.Size = UDim2.new(0, 54, 0, 26)
            runBtn.Position = UDim2.new(1, -60, 0.5, -13)
            runBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 55)
            runBtn.Text = "RUN"
            runBtn.TextColor3 = Color3.new(1,1,1)
            runBtn.TextSize = 11
            runBtn.Font = Enum.Font.GothamMedium
            runBtn.BorderSizePixel = 0
            Instance.new("UICorner", runBtn).CornerRadius = UDim.new(0, 5)

            runBtn.Activated:Connect(function()
                local arg = argBox.Text:match("^%s*(.-)%s*$")
                local full = cmd.name .. (arg ~= "" and (" " .. arg) or "")
                FireCommand(full)
                runBtn.BackgroundColor3 = Color3.fromRGB(0, 80, 30)
                task.wait(0.2)
                runBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 55)
            end)

            argBox.FocusLost:Connect(function(enter)
                if enter then
                    local arg = argBox.Text:match("^%s*(.-)%s*$")
                    local full = cmd.name .. (arg ~= "" and (" " .. arg) or "")
                    FireCommand(full)
                end
            end)
        end
    end
end

